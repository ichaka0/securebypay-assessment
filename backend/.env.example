# Server
NODE_ENV=development
PORT=3000

# CORS: the deployed frontend, plus optional extra comma-separated origins
# (e.g. local Flutter dev). Required when NODE_ENV=production.
FRONTEND_URL=https://securebypay-assessment-five.vercel.app
CORS_ORIGIN=http://localhost:8080

# --- Database: choose ONE of the two options ---------------------------------

# Option A: hosted Postgres (Neon). Paste the bare connection string from the
# Neon dashboard ("Connection string" tab). Do NOT include the leading `psql`
# or the surrounding quotes. When set, it overrides the DB_* settings below.
# Tip: change Neon's `sslmode=require` to `sslmode=verify-full` (same security,
# silences a pg deprecation warning).
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Option B: local Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=myshipment
DB_SSL=false

# Optional: max connections in the pool (default 10)
# DB_POOL_MAX=10

# Auth (use a long random string in production, e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d
