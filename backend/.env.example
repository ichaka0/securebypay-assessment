# Server
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed origins, or * for any (dev only)
CORS_ORIGIN=*

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=my
DB_SSL=false

# Auth (use a long random string in production, e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d
